# Gemini API Key (Required for RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Resend API Key (Required for Emails)
RESEND_API_KEY=your_resend_api_key_here

# Product Hunt Developer Token (Required for Product Hunt API)
PRODUCT_HUNT_DEVELOPER_TOKEN=your_product_hunt_token_here

# To Email Address (Where you want to receive the digest)
TO_EMAIL=your_personal_email@gmail.com

# From Email Address (Sender email, must be verified in Resend)
# Important: If you don't use a verified domain, emails will likely go to spam.
# Format example: "Jarvis <jarvis@yourverifieddomain.com>"
FROM_EMAIL="Jarvis <jarvis@yourverifieddomain.com>"
